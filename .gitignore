# Unreal Engine 5 Gitignore

# Build artifacts
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
.vs/
*.VC.db
*.VC.opendb

# User-specific files
*.suo
*.user
*.userprefs
*.opensdf
*.sdf
*.sln.docstates

# Mac-specific
.DS_Store

# Windows-specific
Thumbs.db
desktop.ini

# Backup files
*.bak
*.tmp
*.old
*.orig

# Project build
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.sdf
*.ipch
*.opensdf

# IDE
.idea/
.vscode/
.vs/

# Unreal specific
# Don’t commit these autogenerated or cache-heavy folders
DerivedDataCache/
Intermediate/
Saved/
Binaries/

# Optional: ignore local plugins not meant for repo
Plugins/*/Intermediate/
Plugins/*/Binaries/

# Ignore local asset packs (ex: 유료 애셋)
# 팀 내부적으로 관리하지 않을 경우
Content/StoreAssets/

# If using Rider
.idea/

# If using JetBrains Rider or CLion
cmake-build-*/

# If using Crash Reports locally
*.dmp
*.mdmp
